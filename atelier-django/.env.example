DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=.vercel.app,atelier-backend-django.vercel.app,localhost,127.0.0.1

# Neon PostgreSQL (pooled connection string from Neon / Vercel)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

PUBLIC_BASE_URL=https://atelier-backend-django.vercel.app
FRONTEND_URL=https://atelier-frontend.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://atelier-frontend.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:3000,https://atelier-frontend.vercel.app,https://atelier-backend-django.vercel.app

ADMIN_NOTIFICATION_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
